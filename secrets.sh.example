# secrets.sh — TEMPLATE. Copy to ../secrets.sh (OUTSIDE this repo) and fill in.
#
#   cp secrets.sh.example ../secrets.sh   # then edit ../secrets.sh
#
# ../secrets.sh lives one level above the repo so it is never tracked. NEVER put
# real API keys in any file inside the repo. The harness sources this file from
# INSIDE the container (it is visible through the mounted /lustre), so the keys
# reach the training process — see DETERMINISM_MOONLIGHT.md ("Configuration").

export WANDB_API_KEY=REPLACE_WITH_YOUR_WANDB_KEY
export HF_TOKEN=REPLACE_WITH_YOUR_HF_TOKEN
export HF_HOME=/lustre/fsw/portfolios/llmservice/users/REPLACE_USER/hf_cache
